{
  "name": "Relances impayés - Envoi après validation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "validations/relance-approuvee",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-validation",
      "name": "Hook Supabase (validation mise à jour)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-320, 0],
      "webhookId": "validations-relance-approuvee"
    },
    {
      "parameters": {
        "jsCode": "// Déclenché par un Database Webhook Supabase sur UPDATE de `validations`\n// (filtré côté Supabase : type_action = 'relance_impaye' AND statut IN ('valide','modifie')).\nconst record = $json.body.record;\nreturn [{\n  json: {\n    validation_statut: record.statut,\n    relance_id: record.reference_id,\n    client_id: record.client_id,\n    contenu: record.contenu_propose,\n  },\n}];"
      },
      "id": "code-extraire",
      "name": "Extraire la relance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-100, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.validation_statut }}",
              "rightValue": "rejete",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-non-rejete",
      "name": "Validation approuvée ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [120, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "relances",
        "filterType": "manual",
        "matchingColumns": ["id"],
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "id", "fieldValue": "={{ $json.relance_id }}" },
            { "fieldId": "statut", "fieldValue": "={{ $json.validation_statut }}" },
            { "fieldId": "date_envoi", "fieldValue": "={{ $now.toISO() }}" }
          ]
        }
      },
      "id": "supabase-update-relance",
      "name": "Marquer la relance envoyée",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [340, -80],
      "credentials": {
        "supabaseApi": { "id": "supabase-dashboard-agence", "name": "Supabase - Dashboard agence" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://TODO-fournisseur-sms-ou-email.example/send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { client_id: $('Extraire la relance').item.json.client_id, message: 'Relance impayé (' + $('Extraire la relance').item.json.contenu.type_rappel + ') : ' + $('Extraire la relance').item.json.contenu.montant + ' EUR' } }}"
      },
      "id": "http-envoyer",
      "name": "Envoyer SMS/email (fournisseur à choisir)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, -80],
      "notes": "Placeholder : brancher le fournisseur SMS/email réel une fois choisi (tâche 5)."
    },
    {
      "parameters": { "respondWith": "noData", "options": { "responseCode": 200 } },
      "id": "respond-ok",
      "name": "Répondre 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [780, 0]
    }
  ],
  "connections": {
    "Hook Supabase (validation mise à jour)": { "main": [[{ "node": "Extraire la relance", "type": "main", "index": 0 }]] },
    "Extraire la relance": { "main": [[{ "node": "Validation approuvée ?", "type": "main", "index": 0 }]] },
    "Validation approuvée ?": {
      "main": [
        [{ "node": "Marquer la relance envoyée", "type": "main", "index": 0 }],
        [{ "node": "Répondre 200", "type": "main", "index": 0 }]
      ]
    },
    "Marquer la relance envoyée": { "main": [[{ "node": "Envoyer SMS/email (fournisseur à choisir)", "type": "main", "index": 0 }]] },
    "Envoyer SMS/email (fournisseur à choisir)": { "main": [[{ "node": "Répondre 200", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
