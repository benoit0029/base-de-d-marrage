{
  "name": "Commandes fournisseurs - Envoi après validation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "validations/commande-approuvee",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-validation",
      "name": "Hook Supabase (validation mise à jour)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-320, 0],
      "webhookId": "validations-commande-approuvee"
    },
    {
      "parameters": {
        "jsCode": "// Déclenché par un Database Webhook Supabase sur UPDATE de `validations`\n// (filtré côté Supabase : type_action = 'commande_fournisseur' AND statut IN ('valide','modifie')).\nconst record = $json.body.record;\nreturn [{\n  json: {\n    validation_statut: record.statut,\n    commande_id: record.reference_id,\n    client_id: record.client_id,\n    contenu: record.contenu_propose,\n  },\n}];"
      },
      "id": "code-extraire",
      "name": "Extraire la commande",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-100, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.validation_statut }}",
              "rightValue": "rejete",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-non-rejete",
      "name": "Validation approuvée ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [120, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "commandes_fournisseurs",
        "filterType": "manual",
        "matchingColumns": ["id"],
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "id", "fieldValue": "={{ $json.commande_id }}" },
            { "fieldId": "montant", "fieldValue": "={{ $json.contenu.montant }}" },
            { "fieldId": "statut", "fieldValue": "={{ $json.validation_statut }}" }
          ]
        }
      },
      "id": "supabase-update-commande",
      "name": "Marquer la commande envoyée",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [340, -80],
      "credentials": {
        "supabaseApi": { "id": "supabase-dashboard-agence", "name": "Supabase - Dashboard agence" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://TODO-envoi-bon-de-commande-fournisseur.example/send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { fournisseur: $('Extraire la commande').item.json.contenu.fournisseur, materiaux: $('Extraire la commande').item.json.contenu.materiaux, montant: $('Extraire la commande').item.json.contenu.montant } }}"
      },
      "id": "http-envoyer",
      "name": "Envoyer le bon de commande (à brancher)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, -80],
      "notes": "Placeholder : canal d'envoi réel au fournisseur (email/EDI) à choisir en tâche 5."
    },
    {
      "parameters": { "respondWith": "noData", "options": { "responseCode": 200 } },
      "id": "respond-ok",
      "name": "Répondre 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [780, 0]
    }
  ],
  "connections": {
    "Hook Supabase (validation mise à jour)": { "main": [[{ "node": "Extraire la commande", "type": "main", "index": 0 }]] },
    "Extraire la commande": { "main": [[{ "node": "Validation approuvée ?", "type": "main", "index": 0 }]] },
    "Validation approuvée ?": {
      "main": [
        [{ "node": "Marquer la commande envoyée", "type": "main", "index": 0 }],
        [{ "node": "Répondre 200", "type": "main", "index": 0 }]
      ]
    },
    "Marquer la commande envoyée": { "main": [[{ "node": "Envoyer le bon de commande (à brancher)", "type": "main", "index": 0 }]] },
    "Envoyer le bon de commande (à brancher)": { "main": [[{ "node": "Répondre 200", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
