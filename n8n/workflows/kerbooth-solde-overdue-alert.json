{
  "name": "Kerbooth 360° — Échec de prélèvement du solde",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "days", "triggerAtHour": 10 }] }
      },
      "id": "22222222-0005-4000-8000-000000000001",
      "name": "Chaque matin à 10h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.APP_URL }}/api/kerbooth/alerts/solde-overdue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $env.INGEST_API_TOKEN }}" }]
        },
        "options": {}
      },
      "id": "22222222-0005-4000-8000-000000000002",
      "name": "Vérifier les soldes en retard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "overdue",
        "options": {}
      },
      "id": "22222222-0005-4000-8000-000000000003",
      "name": "Une ligne par réservation en retard",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "22222222-0005-4000-8000-000000000004",
              "leftValue": "={{ $json.priority }}",
              "rightValue": "relance",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "22222222-0005-4000-8000-000000000005",
      "name": "Relance simple ou alerte prioritaire ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM }}",
        "toEmail": "={{ $json.clientEmail }}",
        "subject": "Kerbooth 360° — Échec du prélèvement du solde de votre location",
        "emailFormat": "text",
        "text": "Bonjour, le prélèvement automatique du solde de votre location ({{ $json.soldeAmount }} €) a échoué. Merci de nous contacter rapidement pour régulariser, ou de vérifier que votre carte est toujours valide.",
        "options": {}
      },
      "id": "22222222-0005-4000-8000-000000000006",
      "name": "Relancer le client",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1120, 220],
      "credentials": { "smtp": { "name": "SMTP — adresse dédiée (émission)" } }
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM }}",
        "toEmail": "={{ $env.NOTIFICATIONS_TO_EMAIL }}",
        "subject": "⚠️ Kerbooth 360° — Solde impayé depuis {{ $json.daysOverdue }} jours (alerte prioritaire)",
        "emailFormat": "text",
        "text": "Réservation {{ $json.bookingId }} ({{ $json.clientName }}, unité {{ $json.unitLabel }}) : solde de {{ $json.soldeAmount }} € toujours impayé après {{ $json.daysOverdue }} jours. La caution (1 500 €) reste la garantie de dernier recours — envisager de l'encaisser si la situation persiste.",
        "options": {}
      },
      "id": "22222222-0005-4000-8000-000000000007",
      "name": "Alerter Benoît (prioritaire)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1120, 380],
      "credentials": { "smtp": { "name": "SMTP — adresse dédiée (émission)" } }
    }
  ],
  "connections": {
    "Chaque matin à 10h": {
      "main": [[{ "node": "Vérifier les soldes en retard", "type": "main", "index": 0 }]]
    },
    "Vérifier les soldes en retard": {
      "main": [[{ "node": "Une ligne par réservation en retard", "type": "main", "index": 0 }]]
    },
    "Une ligne par réservation en retard": {
      "main": [[{ "node": "Relance simple ou alerte prioritaire ?", "type": "main", "index": 0 }]]
    },
    "Relance simple ou alerte prioritaire ?": {
      "main": [
        [{ "node": "Relancer le client", "type": "main", "index": 0 }],
        [{ "node": "Alerter Benoît (prioritaire)", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "id": "33333333-0005-4000-8000-000000000001"
}
