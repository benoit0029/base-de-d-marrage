    {
      "parameters": {
        "jsCode": "// Règle fixe (pas de validation humaine) : échéance à 30 jours à compter d'aujourd'hui.\nconst devis = $json;\nconst echeance = new Date();\necheance.setDate(echeance.getDate() + 30);\n\nreturn [{\n  json: {\n    client_id: devis.client_id,\n    devis_id: devis.id,\n    montant: devis.montant,\n    date_echeance: echeance.toISOString().slice(0, 10),\n  },\n}];"
      },
      "id": "code-calculer-echeance",
      "name": "Calculer l'échéance (J+30)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [120, 0]
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "factures",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "client_id", "fieldValue": "={{ $json.client_id }}" },
            { "fieldId": "devis_id", "fieldValue": "={{ $json.devis_id }}" },
            { "fieldId": "montant", "fieldValue": "={{ $json.montant }}" },
            { "fieldId": "statut", "fieldValue": "emise" },
            { "fieldId": "date_echeance", "fieldValue": "={{ $json.date_echeance }}" }
          ]
        }
      },
      "id": "supabase-insert-facture",
      "name": "Créer la facture",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [340, 0],
      "credentials": {
        "supabaseApi": { "id": "supabase-dashboard-agence", "name": "Supabase - Dashboard agence" }
      }
    },
    {
      "parameters": {
        "method": "POST",
