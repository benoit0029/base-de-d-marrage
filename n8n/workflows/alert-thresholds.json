{
  "name": "Alerte — seuils micro-BA / micro-BIC",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "3ffe3638-6407-4d53-9896-e71538b5fdc5",
      "name": "Chaque matin à 8h",
