      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM }}",
        "toEmail": "={{ $env.NOTIFICATIONS_TO_EMAIL }}",
        "subject": "Compta ferme — alerte seuil micro-BA/micro-BIC",
        "emailFormat": "text",
        "text": "={{ $json.alerts.map(a => `- ${a.label} : ${a.caCumule} € / ${a.seuil} € (${a.level})`).join('\\n') }}\n\nVoir l'onglet Synthèse pour le détail.",
        "options": {}
      },
      "id": "64a340ba-9855-4836-8eb5-b34c329b4e81",
      "name": "Envoyer l'alerte de seuil",
      "type": "n8n-nodes-base.emailSend",
