        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.INGEST_API_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "58ca2c50-4c99-4075-a3a7-f189366e5e2b",
      "name": "Vérifier les seuils",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "90348d0c-3d8d-4281-8567-3747801db1d4",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "cf4073b3-7d5e-4aea-abc4-0f27a5134138",
      "name": "Un seuil en vigilance ou dépassé ?",
