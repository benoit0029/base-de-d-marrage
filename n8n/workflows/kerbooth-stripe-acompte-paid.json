{
  "name": "Kerbooth 360° — Acompte payé (Stripe)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kerbooth-stripe-acompte-paid",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "c1c1c1c1-0002-4000-8000-000000000001",
      "name": "Webhook Stripe (acompte réglé)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "kerbooth-stripe-acompte-paid",
      "notes": "À connecter à l'événement Stripe payment_intent.succeeded (ou checkout.session.completed selon l'intégration HubSpot+Stripe retenue). Le bookingId doit être passé en métadonnée Stripe à la création du paiement pour être retrouvé ici — voir $json.body.data.object.metadata.bookingId."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_URL }}/api/kerbooth/bookings/{{ $json.body.data.object.metadata.bookingId }}/acompte-paid",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.INGEST_API_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ stripeCustomerId: $json.body.data.object.customer, paidAt: new Date($json.body.data.object.created * 1000).toISOString() }) }}",
        "options": {}
      },
      "id": "c1c1c1c1-0002-4000-8000-000000000002",
      "name": "Marquer l'acompte payé (facture + statut)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.yousign.com/v3/signature_requests",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $env.YOUSIGN_API_KEY }}" }]
        },
        "options": {}
      },
      "id": "c1c1c1c1-0002-4000-8000-000000000003",
      "name": "Envoyer le contrat à signer (Yousign)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "notes": "À COMPLÉTER : corps de la requête Yousign (document du contrat rempli avec les infos de la réservation, signataires). Vérifier le endpoint exact et le format sur la documentation Yousign API v3 au moment de la connexion réelle — non testé ici."
    }
  ],
  "connections": {
    "Webhook Stripe (acompte réglé)": {
      "main": [[{ "node": "Marquer l'acompte payé (facture + statut)", "type": "main", "index": 0 }]]
    },
    "Marquer l'acompte payé (facture + statut)": {
      "main": [[{ "node": "Envoyer le contrat à signer (Yousign)", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "id": "d1d1d1d1-0002-4000-8000-000000000001"
}
