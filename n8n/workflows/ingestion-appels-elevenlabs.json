{
  "name": "Ingestion appels - ElevenLabs",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "elevenlabs/appel-termine",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-elevenlabs",
      "name": "Webhook ElevenLabs (post-call)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-380, 0],
      "webhookId": "elevenlabs-appel-termine"
    },
    {
      "parameters": {
        "jsCode": "// Les nœuds HTTP Request classiques n'ont pas accès à $env par défaut (restriction de sécurité n8n).\n// Les nœuds Code, eux, y ont accès sans restriction : on lit donc les variables ici\n// et on les transmet comme données normales au nœud suivant.\nreturn [{\n  json: {\n    ...$json,\n    _supabase_url: $env.SUPABASE_URL,\n    _supabase_key: $env.SUPABASE_SERVICE_ROLE_KEY,\n  },\n}];"
      },
      "id": "code-lire-env",
      "name": "Lire config Supabase",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-270, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json._supabase_url }}/rest/v1/client_config",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "client_id" },
            { "name": "cle", "value": "eq.elevenlabs_agent_id" },
            { "name": "valeur", "value": "=eq.\"{{ $json.body.data.agent_id }}\"" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $json._supabase_key }}" },
            { "name": "Authorization", "value": "=Bearer {{ $json._supabase_key }}" }
          ]
        }
      },
      "id": "supabase-resoudre-client",
      "name": "Résoudre le client (agent ElevenLabs)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-160, 0],
      "notes": "Chaque client a son propre agent ElevenLabs ; l'association agent_id -> client_id est stockée dans client_config (couche personnalisable par client). Appel REST direct (pas le nœud Supabase natif) car son filtre par égalité sur une colonne jsonb n'est pas fiable après import JSON."
    },
    {
      "parameters": {
        "jsCode": "// Format du webhook post-call ElevenLabs Conversational AI :\n// body.data.analysis.data_collection_results contient les champs personnalisés\n// configurés sur l'agent (rdv_pris, spam, urgence_detectee, urgence_description),\n// à définir dans l'onglet \"Data collection\" de l'agent ElevenLabs.\n// Documentation complète : n8n/workflows/README.md\nconst clientId = $('Résoudre le client (agent ElevenLabs)').item.json[0]?.client_id;\nif (!clientId) {\n  throw new Error('Aucun client associé à cet agent_id ElevenLabs (client_config.elevenlabs_agent_id)');\n}\n\nconst data = $('Webhook ElevenLabs (post-call)').item.json.body.data;\nconst champs = data.analysis?.data_collection_results ?? {};\nconst spam = Boolean(champs.spam?.value);\nconst decroche = data.status === 'done';\nconst statut = spam ? 'spam' : decroche ? 'decroche' : 'manque';\n\nreturn [{\n  json: {\n    client_id: clientId,\n    statut,\n    rdv_pris: Boolean(champs.rdv_pris?.value),\n    duree_secondes: data.metadata?.call_duration_secs ?? null,\n    urgence: Boolean(champs.urgence_detectee?.value),\n    urgence_description: champs.urgence_description?.value ?? null,\n    urgence_sms_envoye: Boolean(champs.urgence_sms_envoye?.value),\n    urgence_transfert: Boolean(champs.urgence_transfert?.value),\n  },\n}];"
      },
      "id": "code-mapper",
      "name": "Mapper les champs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [60, 0]
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "appels",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "client_id", "fieldValue": "={{ $json.client_id }}" },
            { "fieldId": "statut", "fieldValue": "={{ $json.statut }}" },
            { "fieldId": "rdv_pris", "fieldValue": "={{ $json.rdv_pris }}" },
            { "fieldId": "duree_secondes", "fieldValue": "={{ $json.duree_secondes }}" }
          ]
        }
      },
      "id": "supabase-insert-appel",
      "name": "Insérer l'appel",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [280, 0],
      "credentials": {
        "supabaseApi": { "id": "supabase-dashboard-agence", "name": "Supabase - Dashboard agence" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $('Mapper les champs').item.json.urgence }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-urgence",
      "name": "Urgence détectée ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 0]
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "urgences",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "appel_id", "fieldValue": "={{ $('Insérer l\\'appel').item.json.id }}" },
            { "fieldId": "client_id", "fieldValue": "={{ $('Mapper les champs').item.json.client_id }}" },
            { "fieldId": "description", "fieldValue": "={{ $('Mapper les champs').item.json.urgence_description }}" },
            { "fieldId": "sms_envoye", "fieldValue": "={{ $('Mapper les champs').item.json.urgence_sms_envoye }}" },
            { "fieldId": "transfert", "fieldValue": "={{ $('Mapper les champs').item.json.urgence_transfert }}" }
          ]
        }
      },
      "id": "supabase-insert-urgence",
      "name": "Insérer l'urgence",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [720, -80],
      "credentials": {
        "supabaseApi": { "id": "supabase-dashboard-agence", "name": "Supabase - Dashboard agence" }
      }
    },
    {
      "parameters": { "respondWith": "noData", "options": { "responseCode": 200 } },
      "id": "respond-ok",
      "name": "Répondre 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [720, 80]
    }
  ],
  "connections": {
