# --- Application ---
NODE_ENV=production
APP_URL=https://compta.example.fr   # à remplacer par le sous-domaine définitif
SESSION_SECRET=change-me-generate-a-long-random-string

# --- Base de données ---
DATABASE_URL=postgresql://compta:change-me@db:5432/compta

# --- Authentification / 2FA ---
# Le secret TOTP par utilisateur est généré et stocké en base (chiffré), pas ici.

# --- Mistral AI (OCR + extraction) ---
MISTRAL_API_KEY=

# --- Plateforme Agréée de facturation électronique (Abby) ---
PA_PROVIDER=ABBY
PA_API_KEY=

# --- Email dédié (capture des factures entrantes + envoi de notifications) ---
INGEST_IMAP_HOST=
INGEST_IMAP_USER=
INGEST_IMAP_PASSWORD=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# --- n8n (instance existante sur le VPS) ---
N8N_WEBHOOK_BASE_URL=https://n8n.example.fr

# --- Stockage fichiers (documents, PDF) ---
# Local par défaut (volume Docker) ; compatible S3 pour brancher un bucket externe (sauvegardes, phase 6)
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
