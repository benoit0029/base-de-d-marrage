# --- Application ---
NODE_ENV=production
APP_URL=https://compta.example.fr   # à remplacer par le sous-domaine définitif
SESSION_SECRET=change-me-generate-a-long-random-string

# --- Activités affichées ---
# Vide = toutes les activités (Maraîchage, Revente, Kerbooth). Pour une
# installation qui n'a que Kerbooth (partenaire) :
# HIDDEN_ACTIVITIES=maraichage,fruits-legumes
HIDDEN_ACTIVITIES=

# --- Base de données ---
# POSTGRES_* sont lues par docker-compose.yml pour initialiser le conteneur ;
# DATABASE_URL (utilisée par l'app/Prisma) doit reprendre les mêmes identifiants.
POSTGRES_USER=compta
POSTGRES_PASSWORD=change-me
POSTGRES_DB=compta
DATABASE_URL=postgresql://compta:change-me@db:5432/compta

# --- Authentification / 2FA ---
# Compte unique créé au premier accès (/setup), 2FA obligatoire avant toute
# session. Le secret TOTP est généré et stocké en base, chiffré avec
# APP_ENCRYPTION_KEY (voir plus bas) — rien à renseigner ici.

# --- Mistral AI (OCR + extraction) ---
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_CHAT_MODEL=mistral-small-latest

# --- Pipeline de capture (phase 3) ---
# Jeton partagé exigé par /api/agents/ingest (appelé par n8n et les formulaires
# de capture) tant que l'authentification complète (phase 6) n'est pas en place.
INGEST_API_TOKEN=change-me-generate-a-long-random-string

# --- Plateforme Agréée de facturation électronique (Abby) ---
# Pas de clé ici : se configure et se teste depuis Réglages, stockée chiffrée
# en base (PaConnection). ABBY_API_BASE_URL ne sert qu'à pointer vers un autre
# environnement (ex. sandbox de test) si Abby en propose un.
ABBY_API_BASE_URL=https://api.abby.fr/v1

# --- Chiffrement des champs sensibles en base (mots de passe IMAP, etc.) ---
# Générer une fois avec `openssl rand -base64 32` et ne JAMAIS la changer
# ensuite (les secrets déjà chiffrés deviendraient illisibles).
APP_ENCRYPTION_KEY=

# --- Boîtes mail de capture (une par activité) ---
# Ne sont PAS configurées ici : elles se saisissent et se testent depuis
# l'écran Réglages de l'application (comme l'identité et la connexion PA),
# stockées chiffrées en base (voir MailboxConnection dans le schéma Prisma).
# La boîte d'origine est transmise à /api/agents/ingest comme indice quasi
# certain de l'activité, utilisé par l'agent de classement avant même
# d'analyser le contenu du document.

# --- Adresse dédiée en émission seule (envoi des PDF/notifications de l'outil) ---
# Boîte distincte des 3 boîtes de capture ci-dessus : jamais surveillée en
# entrée, uniquement utilisée par l'app/n8n pour envoyer des emails.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# --- n8n (instance existante sur le VPS) ---
# Les workflows n8n (n8n/workflows/) appellent l'application, pas l'inverse :
# rien à configurer ici côté app. Voir n8n/workflows/README.md pour les
# variables à définir côté instance n8n (APP_URL, INGEST_API_TOKEN, etc.).

# --- Stockage fichiers (documents, PDF) ---
# "local" (volume Docker) ou "s3" (Scaleway Object Storage, recommandé pour
# la conservation légale des justificatifs — voir docs/ARCHITECTURE.md) sans
# changer les appelants (voir src/lib/storage/index.ts) — à distinguer des
# variables BACKUP_S3_* ci-dessous, qui servent aux sauvegardes chiffrées de
# la base de données, pas au stockage courant des documents.
#
# Pour passer de local à s3 : renseigner STORAGE_S3_* ci-dessous, lancer
# `npm run storage:migrate-to-s3` (depuis apps/web, migre les fichiers déjà
# stockés en local vers le bucket), PUIS seulement changer STORAGE_DRIVER=s3
# et redéployer.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/documents
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=fr-par
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# --- Sauvegardes chiffrées (scripts/backup.sh) ---
# Stockage S3-compatible SÉPARÉ du VPS applicatif (ex. Scaleway, OVH,
# Backblaze B2...). Voir docs/DEPLOYMENT.md §5 pour la mise en place et le
# test de restauration (scripts/restore.sh).
BACKUP_ENCRYPTION_PASSPHRASE=change-me-generate-a-long-random-string
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
