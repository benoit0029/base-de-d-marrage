// Schéma de base de données — Phase 1 (proposition à valider)
// Convention : chaque table métier porte un tenantId pour préparer la v2 multi-client.
// En v1, une seule ligne existe dans `Tenant`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Multi-tenant / identité
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users             User[]
  companySettings   CompanySettings?
  activitySettings  ActivitySettings[]
  documents         Document[]
  entries           Entry[]
  invoices          Invoice[]
  payrollEmployees  PayrollEmployee[]
  tvaDeclarations   TvaDeclaration[]
  thresholdSnapshots ThresholdSnapshot[]
  paConnections     PaConnection[]
  mailboxConnections MailboxConnection[]
  notificationLogs  NotificationLog[]
  auditLogs         AuditLog[]
  cashJournalEntries CashJournalEntry[]
  simpleImports      SimpleImport[]
  bankTransactions   BankTransaction[]
  tvaInstallments    TvaInstallment[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  totpSecret   String? // rempli à l'activation obligatoire du 2FA
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())

  auditLogs AuditLog[]
}

model CompanySettings {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  legalName     String
  address       String
  siren         String
  vatNumber     String? // TVA intracommunautaire
  contactEmail  String? // valeur par défaut, reprise par activité si non précisée (voir ActivitySettings.contactEmail)
  updatedAt     DateTime @updatedAt
}

enum Activity {
  BA_MARAICHAGE
  BIC_FRUITS_LEGUMES
  BIC_PHOTOBOOTH
}

model ActivitySettings {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  activity           Activity
  logoUrl            String?
  accentColorHex     String? // utilisé en bandeau/liseré, jamais en fond plein
  abCertificationCode String? // format FR-BIO-XX, uniquement BA_MARAICHAGE / BIC_FRUITS_LEGUMES
  abLogoEnabled      Boolean  @default(false) // désactivé par défaut : à activer seulement après vérification du guide INAO "Règles d'usage de la marque AB"
  legalMentions      String?  @db.Text
  invoicingEnabled   Boolean  @default(false) // actif par défaut pour Maraîchage & Photobooth ; Fruits/Légumes reste 100% vente directe, jamais facturé
  contactEmail       String?  // email affiché sur les factures de cette activité ; vide = reprend CompanySettings.contactEmail
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, activity])
}

// ---------------------------------------------------------------------------
// Pipeline de capture / extraction IA
// ---------------------------------------------------------------------------

enum DocumentSource {
  EMAIL
  PHOTO
  UPLOAD
}

enum DocumentStatus {
  RECEIVED
  CLASSIFYING
  IGNORED_NOISE
  EXTRACTING
  EXTRACTED
  FAILED
}

model Document {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  source         DocumentSource
  status         DocumentStatus @default(RECEIVED)
  fileUrl        String // chemin du fichier stocké (volume local ou S3-compatible)
  mimeType       String
  emailFrom      String?
  emailSubject   String?
  // Boîte mail d'origine quand source = EMAIL (une boîte IMAP dédiée par
  // activité, voir .env.example) : indice quasi certain de l'activité,
  // transmis à l'agent de classement en priorité sur l'analyse du contenu.
  sourceMailboxActivity Activity?
  receivedAt     DateTime       @default(now())
  extractionJson Json? // dernier résultat structuré de l'agent d'extraction

  // Détection de doublon (un même document peut arriver par email ET par
  // capture manuelle) : hash du fichier calculé à l'ingestion, comparé aux
  // documents déjà connus du tenant. Non bloquant ici (contrairement aux
  // imports simples) : l'écriture PENDING générée porte juste un signalement
  // que l'utilisateur voit avant de valider — voir lib/dedup.ts.
  fileHash              String?
  possibleDuplicateOfId String?
  possibleDuplicateOf   Document?  @relation("DocumentDuplicate", fields: [possibleDuplicateOfId], references: [id])
  duplicateCandidates   Document[] @relation("DocumentDuplicate")

  extractionJobs ExtractionJob[]
  entry          Entry?
}

enum AgentStep {
  EMAIL_TRIAGE // agent de veille email : classification bruit/pertinent
  OCR_EXTRACT // agent d'extraction Mistral OCR
  ACTIVITY_CLASSIFY // agent de classement/ventilation
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model ExtractionJob {
  id         String    @id @default(cuid())
  documentId String
  document   Document  @relation(fields: [documentId], references: [id])
  step       AgentStep
  status     JobStatus @default(PENDING)
  resultJson Json?
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

// ---------------------------------------------------------------------------
// Écritures comptables (recettes / achats / immobilisations)
// ---------------------------------------------------------------------------

enum EntryType {
  RECETTE
  ACHAT
  IMMOBILISATION
}

enum EntryStatus {
  PENDING // proposé par l'IA, en attente de validation humaine
  VALIDATED // verrouillé après validation (traçabilité)
}

model Entry {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  activity        Activity
  type            EntryType
  status          EntryStatus @default(PENDING)
  date            DateTime
  amountHt        Decimal     @db.Decimal(12, 2)
  amountVat       Decimal     @db.Decimal(12, 2)
  amountTtc       Decimal     @db.Decimal(12, 2)
  counterpartyName String
  nature          String
  sourceDocumentId String?    @unique
  sourceDocument  Document?   @relation(fields: [sourceDocumentId], references: [id])
  validatedById   String?
  validatedAt     DateTime?
  createdAt       DateTime    @default(now())

  // Suppression douce (ligne déjà validée) : jamais réaffichée nulle part,
  // mais conservée en base pour un contrôle fiscal éventuel. Une ligne encore
  // PENDING peut en revanche être vraiment supprimée (voir services).
  deletedAt DateTime?

  // Rapprochement bancaire (une Dépense ↔ un débit du relevé importé).
  bankTransactionId String?          @unique
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  // Écriture générée automatiquement par un import Tesa+ (cotisations
  // salariales) ou "Cotisations non salarié" (voir SimpleImport.linkedEntryId)
  // — présent seulement dans ce cas.
  simpleImport      SimpleImport?

  @@index([tenantId, activity, status])
}

// ---------------------------------------------------------------------------
// Journal de caisse (vente directe) — Maraîchage et Fruits/Légumes uniquement
// ---------------------------------------------------------------------------

// Saisie journalière agrégée des ventes directes (une ligne par jour et par
// activité), DISTINCTE du livre des recettes : elle n'en est qu'une des
// sources. Pour Fruits/Légumes (100% vente directe), le livre des recettes ne
// contient que ces lignes. Pour Maraîchage, elles coexistent avec les lignes
// de facture (une ligne par facture ET une ligne par jour de vente directe),
// sans jamais être fusionnées même à date identique — voir docs/ARCHITECTURE.md.
//
// Comptes bancaires distincts : Fruits/Légumes n'encaisse qu'en espèces
// (checkAmount/cardAmount toujours à 0, justificatif = photo du bordereau de
// dépôt). Maraîchage agrège espèces/chèques/CB (justificatifs = bordereau +
// capture d'écran Up2Pay pour la part CB).
//
// La saisie agrégée journalière n'est légale que pour des ventes unitaires
// ≤ 76 € (BOI-BIC-DECLA-30-30, voir CASH_JOURNAL_DAILY_THRESHOLD dans
// lib/thresholds) : toute vente dépassant ce seuil doit être saisie à part
// dans exceptionalSales plutôt qu'agrégée dans cashAmount/checkAmount/cardAmount.
model CashJournalEntry {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  activity         Activity
  date             DateTime
  cashAmount       Decimal     @db.Decimal(12, 2) @default(0)
  checkAmount      Decimal     @db.Decimal(12, 2) @default(0) // Maraîchage uniquement
  cardAmount       Decimal     @db.Decimal(12, 2) @default(0) // Maraîchage uniquement
  depositSlipUrl   String? // photo du bordereau de dépôt (espèces/chèques)
  cardStatementUrl String? // capture d'écran app bancaire Up2Pay (Maraîchage, part CB)
  // Ventes unitaires > 76 € saisies à part, jamais agrégées ci-dessus.
  // Tableau JSON de { amountTtc: number, paymentMethod: string, description?: string }.
  exceptionalSales Json?
  status           EntryStatus @default(PENDING)
  validatedById    String?
  validatedAt      DateTime?
  createdAt        DateTime    @default(now())

  // Suppression douce une fois validée (voir Entry.deletedAt).
  deletedAt DateTime?

  // Rapprochement bancaire (une saisie de caisse ↔ un crédit du relevé
  // importé — typiquement le dépôt en banque des espèces/chèques du jour).
  bankTransactionId String?          @unique
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  @@unique([tenantId, activity, date])
  @@index([tenantId, activity, status])
}

// ---------------------------------------------------------------------------
// Facturation / devis (moteur unique, transverse aux 3 activités)
// ---------------------------------------------------------------------------

enum InvoiceType {
  DEVIS
  FACTURE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  activity       Activity
  type           InvoiceType
  number         String        @unique // numérotation automatique par activité
  clientName     String
  clientAddress  String?
  issueDate      DateTime
  dueDate        DateTime?
  status         InvoiceStatus @default(DRAFT)
  vatApplicable  Boolean       @default(false) // false tant que franchise en base s'applique
  abLabelShown   Boolean       @default(false)
  totalHt        Decimal       @db.Decimal(12, 2)
  totalVat       Decimal       @db.Decimal(12, 2)
  totalTtc       Decimal       @db.Decimal(12, 2)
  pdfUrl         String?
  paExternalId   String? // référence côté PA (Abby) une fois transmise
  createdAt      DateTime      @default(now())

  // Rapprochement bancaire (une facture ↔ un crédit du relevé importé).
  bankTransactionId String?          @unique
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  lines InvoiceLine[]
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  vatRate     Decimal @db.Decimal(5, 2) @default(0)
  lineTotal   Decimal @db.Decimal(12, 2)
}

// ---------------------------------------------------------------------------
// Paie (volet salarié, micro-BA)
// ---------------------------------------------------------------------------

model PayrollEmployee {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  firstName String
  lastName  String
  contractInfo Json? // type de contrat, temps de travail, taux horaire, etc.
  createdAt DateTime @default(now())

  payslips Payslip[]
}

model Payslip {
  id          String   @id @default(cuid())
  employeeId  String
  employee    PayrollEmployee @relation(fields: [employeeId], references: [id])
  period      String // ex. "2026-09"
  grossAmount Decimal  @db.Decimal(12, 2)
  netAmount   Decimal  @db.Decimal(12, 2)
  dsnStatus   String?  // statut de transmission DSN
  pdfUrl      String?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// TVA / déclarations
// ---------------------------------------------------------------------------

model TvaDeclaration {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  period    String // ex. "2026-T3" pour un acompte trimestriel RSA
  regime    String // "RSA" (régime simplifié agricole), "CA12A", etc.
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("A_PREPARER") // A_PREPARER / DEPOSEE / PAYEE
  dueDate   DateTime
  createdAt DateTime @default(now())
}

// Acompte TVA (Maraîchage, régime simplifié agricole) : simple import après
// paiement (justificatif), même cycle PENDING/VALIDATED que le reste des
// registres. Le Registre TVA (calcul automatique, voir lib/tva) confronte
// ces paiements enregistrés au montant réellement dû par trimestre.
model TvaInstallment {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  dueLabel        String // ex. "2026-T3", ou "Régularisation annuelle"
  amountPaid      Decimal     @db.Decimal(12, 2)
  paidAt          DateTime
  justificatifUrl String?
  fileHash        String? // détection de doublon — voir lib/dedup.ts
  status          EntryStatus @default(PENDING)
  validatedById   String?
  validatedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())

  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// Suivi des seuils (agent de suivi/alerte)
// ---------------------------------------------------------------------------

enum ThresholdScope {
  BIC_COMBINED // fruits/légumes + photobooth cumulés (même micro-entreprise)
  BA_MARAICHAGE
}

model ThresholdSnapshot {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  scope        ThresholdScope
  period       String // ex. "2026"
  caCumule     Decimal        @db.Decimal(12, 2)
  thresholdRef Decimal        @db.Decimal(12, 2) // ex. 37500 ou 85000
  alertLevel   String         @default("OK") // OK / VIGILANCE / DEPASSEMENT
  computedAt   DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Intégration PA (facturation électronique)
// ---------------------------------------------------------------------------

model PaConnection {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  provider       String   @default("ABBY")
  apiKeyEncrypted String
  status         String   @default("DISCONNECTED") // DISCONNECTED / CONNECTED / ERROR
  connectedAt    DateTime?
}

// Boîte mail de capture dédiée à une activité (une par activité, saisie et
// testée depuis Réglages — pas fixée en dur au déploiement). Le mot de passe
// IMAP est chiffré avant stockage (voir src/lib/crypto.ts).
model MailboxConnection {
  id                    String    @id @default(cuid())
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  activity              Activity
  imapHost              String?
  imapPort              Int       @default(993)
  imapUser              String?
  imapPasswordEncrypted String?
  status                String    @default("NOT_TESTED") // NOT_TESTED / CONNECTED / ERROR
  lastError             String?
  lastTestedAt          DateTime?
  updatedAt             DateTime  @updatedAt

  @@unique([tenantId, activity])
}

// ---------------------------------------------------------------------------
// Notifications (n8n / email)
// ---------------------------------------------------------------------------

model NotificationLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  channel   String // "EMAIL" / "N8N"
  type      String // ex. "ENTRY_PENDING_TOO_LONG", "THRESHOLD_ALERT", "DECLARATION_DUE"
  payload   Json?
  sentAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Imports simples (Tesa+, Cotisations non salarié) — upload + date, sans
// calculateur : tous les types de documents d'une même catégorie sont
// traités de façon identique. Voir docs/ARCHITECTURE.md.
// ---------------------------------------------------------------------------

enum SimpleImportCategory {
  TESA_CONTRAT
  TESA_BULLETIN_PAIE
  TESA_COTISATIONS_SALARIALES
  TESA_CERTIFICAT_TRAVAIL
  TESA_ATTESTATION_POLE_EMPLOI
  TESA_SOLDE_TOUT_COMPTE
  COTISATION_NON_SALARIE // appel de cotisation MSA de l'exploitant (Maraîchage)
}

model SimpleImport {
  id       String               @id @default(cuid())
  tenantId String
  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  activity Activity // BA_MARAICHAGE pour toutes les catégories actuelles (Tesa+ et cotisation non salarié)
  category SimpleImportCategory
  period   String? // ex. "2026-09" (période de contrat ou d'appel de cotisation)
  date     DateTime
  fileUrl  String
  fileHash String // détection de doublon — voir lib/dedup.ts

  // Montant optionnel (obligatoire en pratique pour COTISATION_NON_SALARIE et
  // TESA_COTISATIONS_SALARIALES, qui génèrent une ligne de Dépense à la
  // validation — voir linkedEntry).
  amountTtc Decimal? @db.Decimal(12, 2)

  // Même cycle PENDING/VALIDATED que le reste des registres. La Dépense
  // liée (linkedEntry) n'est créée qu'à la validation, pas à l'import — pour
  // ne jamais faire apparaître une dépense avant confirmation humaine.
  status        EntryStatus @default(PENDING)
  validatedById String?
  validatedAt   DateTime?
  deletedAt     DateTime? // suppression douce une fois validée

  linkedEntryId String? @unique
  linkedEntry   Entry?  @relation(fields: [linkedEntryId], references: [id])

  possibleDuplicateOfId String?
  possibleDuplicateOf   SimpleImport?  @relation("SimpleImportDuplicate", fields: [possibleDuplicateOfId], references: [id])
  duplicateCandidates   SimpleImport[] @relation("SimpleImportDuplicate")
  duplicateConfirmed    Boolean        @default(false) // saisie malgré l'alerte de doublon probable

  createdAt DateTime @default(now())

  @@index([tenantId, activity, category])
}

// ---------------------------------------------------------------------------
// Relevé bancaire et rapprochement — un compte réel par activité (Maraîchage,
// Fruits/Légumes, Kerbooth 360 : 3 comptes distincts). Import simple
// (PDF/CSV téléchargé depuis la banque en ligne), pas de connexion DSP2 en
// v1. Chaque ligne peut être rapprochée d'une Dépense (Entry), d'une facture
// ou d'une saisie de caisse — jamais les deux sens à la fois, un seul FK par
// cible, posé côté cible (voir Entry/Invoice/CashJournalEntry.bankTransactionId).
// ---------------------------------------------------------------------------

enum BankTransactionDirection {
  DEBIT
  CREDIT
}

model BankTransaction {
  id             String                   @id @default(cuid())
  tenantId       String
  tenant         Tenant                   @relation(fields: [tenantId], references: [id])
  activity       Activity
  date           DateTime
  label          String // libellé tel qu'il apparaît sur le relevé
  amount         Decimal                  @db.Decimal(12, 2) // toujours positif ; le sens est donné par `direction`
  direction      BankTransactionDirection
  sourceFileUrl  String? // relevé d'origine (CSV/PDF) dont la ligne est issue
  sourceFileHash String? // détection de doublon d'import (même relevé importé deux fois)

  possibleDuplicateOfId String?
  possibleDuplicateOf   BankTransaction?  @relation("BankTransactionDuplicate", fields: [possibleDuplicateOfId], references: [id])
  duplicateCandidates   BankTransaction[] @relation("BankTransactionDuplicate")
  duplicateConfirmed    Boolean           @default(false)

  // Même cycle PENDING/VALIDATED que le reste des registres : une ligne
  // importée reste "en attente" tant qu'elle n'a pas été relue, "Valider"
  // la confirme en un clic.
  status        EntryStatus @default(PENDING)
  validatedById String?
  validatedAt   DateTime?

  deletedAt DateTime? // suppression douce (ligne déjà validée)
  createdAt DateTime  @default(now())

  entry            Entry?
  invoice          Invoice?
  cashJournalEntry CashJournalEntry?

  @@index([tenantId, activity, direction, date])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // ex. "ENTRY_VALIDATED", "INVOICE_CREATED", "SETTINGS_UPDATED"
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
}
