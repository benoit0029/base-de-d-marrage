// Schéma de base de données — Phase 1 (proposition à valider)
// Convention : chaque table métier porte un tenantId pour préparer la v2 multi-client.
// En v1, une seule ligne existe dans `Tenant`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Multi-tenant / identité
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users             User[]
  companySettings   CompanySettings?
  activitySettings  ActivitySettings[]
  documents         Document[]
  entries           Entry[]
  invoices          Invoice[]
  payrollEmployees  PayrollEmployee[]
  tvaDeclarations   TvaDeclaration[]
  thresholdSnapshots ThresholdSnapshot[]
  paConnections     PaConnection[]
  mailboxConnections MailboxConnection[]
  notificationLogs  NotificationLog[]
  auditLogs         AuditLog[]
  cashJournalEntries CashJournalEntry[]
  simpleImports      SimpleImport[]
  bankTransactions   BankTransaction[]
  tvaInstallments    TvaInstallment[]
  clients            Client[]
  products           Product[]
  fiscalYearClosures FiscalYearClosure[]
  kerboothUnits      KerboothUnit[]
  kerboothBookings   KerboothBooking[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  totpSecret   String? // rempli à l'activation obligatoire du 2FA
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())

  auditLogs AuditLog[]
}

model CompanySettings {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  legalName     String
  address       String
  siren         String
  vatNumber     String? // TVA intracommunautaire
  contactEmail  String? // valeur par défaut, reprise par activité si non précisée (voir ActivitySettings.contactEmail)
  updatedAt     DateTime @updatedAt
}

enum Activity {
  BA_MARAICHAGE
  BIC_FRUITS_LEGUMES
  BIC_PHOTOBOOTH
}

model ActivitySettings {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  activity           Activity
  logoUrl            String?
  accentColorHex     String? // utilisé en bandeau/liseré, jamais en fond plein
  abCertificationCode String? // format FR-BIO-XX, uniquement BA_MARAICHAGE / BIC_FRUITS_LEGUMES
  abLogoEnabled      Boolean  @default(false) // désactivé par défaut : à activer seulement après vérification du guide INAO "Règles d'usage de la marque AB"
  legalMentions      String?  @db.Text
  invoicingEnabled   Boolean  @default(false) // actif par défaut pour Maraîchage & Photobooth ; Fruits/Légumes reste 100% vente directe, jamais facturé
  contactEmail       String?  // email affiché sur les factures de cette activité ; vide = reprend CompanySettings.contactEmail
  // Acomptes trimestriels de TVA (régime simplifié agricole, BA_MARAICHAGE
  // uniquement) : dispensés de plein droit si la TVA due l'année précédente
  // était inférieure à 1 000 € (à vérifier chaque année par l'exploitant,
  // ce champ n'automatise pas cette vérification). Vrai par défaut (cas le
  // plus courant), jamais un comportement forcé — voir lib/tva et
  // app/maraichage/acomptes.
  tvaInstallmentsEnabled Boolean @default(true)
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, activity])
}

// ---------------------------------------------------------------------------
// Pipeline de capture / extraction IA
// ---------------------------------------------------------------------------

enum DocumentSource {
  EMAIL
  PHOTO
  UPLOAD
}

enum DocumentStatus {
  RECEIVED
  CLASSIFYING
  IGNORED_NOISE
  EXTRACTING
  EXTRACTED
  FAILED
}

model Document {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  source         DocumentSource
  status         DocumentStatus @default(RECEIVED)
  fileUrl        String // chemin du fichier stocké (volume local ou S3-compatible)
  mimeType       String
  emailFrom      String?
  emailSubject   String?
  // Boîte mail d'origine quand source = EMAIL (une boîte IMAP dédiée par
  // activité, voir .env.example) : indice quasi certain de l'activité,
  // transmis à l'agent de classement en priorité sur l'analyse du contenu.
  sourceMailboxActivity Activity?
  receivedAt     DateTime       @default(now())
  extractionJson Json? // dernier résultat structuré de l'agent d'extraction

  // Détection de doublon (un même document peut arriver par email ET par
  // capture manuelle) : hash du fichier calculé à l'ingestion, comparé aux
  // documents déjà connus du tenant. Non bloquant ici (contrairement aux
  // imports simples) : l'écriture PENDING générée porte juste un signalement
  // que l'utilisateur voit avant de valider — voir lib/dedup.ts.
  fileHash              String?
  possibleDuplicateOfId String?
  possibleDuplicateOf   Document?  @relation("DocumentDuplicate", fields: [possibleDuplicateOfId], references: [id])
  duplicateCandidates   Document[] @relation("DocumentDuplicate")

  extractionJobs ExtractionJob[]
  entry          Entry?
}

enum AgentStep {
  EMAIL_TRIAGE // agent de veille email : classification bruit/pertinent
  OCR_EXTRACT // agent d'extraction Mistral OCR
  ACTIVITY_CLASSIFY // agent de classement/ventilation
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model ExtractionJob {
  id         String    @id @default(cuid())
  documentId String
  document   Document  @relation(fields: [documentId], references: [id])
  step       AgentStep
  status     JobStatus @default(PENDING)
  resultJson Json?
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

// ---------------------------------------------------------------------------
// Écritures comptables (recettes / achats / immobilisations)
// ---------------------------------------------------------------------------

enum EntryType {
  RECETTE
  ACHAT
  IMMOBILISATION
}

enum EntryStatus {
  PENDING // proposé par l'IA, en attente de validation humaine
  VALIDATED // verrouillé après validation (traçabilité)
}

model Entry {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  activity        Activity
  type            EntryType
  status          EntryStatus @default(PENDING)
  date            DateTime
  amountHt        Decimal     @db.Decimal(12, 2)
  amountVat       Decimal     @db.Decimal(12, 2)
  amountTtc       Decimal     @db.Decimal(12, 2)
  counterpartyName String
  nature          String
  sourceDocumentId String?    @unique
  sourceDocument  Document?   @relation(fields: [sourceDocumentId], references: [id])
  validatedById   String?
  validatedAt     DateTime?
  createdAt       DateTime    @default(now())

  // Comptabilité de caisse (micro-BA/micro-BIC) : c'est la date de PAIEMENT,
  // pas la date de facture ci-dessus, qui détermine l'exercice fiscal. Une
  // Dépense validée mais pas encore payée est une DETTE en cours (affichée
  // "Facture reçue — dette en cours") ; elle n'entre dans aucun calcul de
  // TVA déductible ni de seuil tant que paidAt est vide. Voir lib/tva et
  // lib/thresholds — BOFiP BOI-BA-BASE-20-10.
  paidAt DateTime?

  // Suppression douce (ligne déjà validée) : jamais réaffichée nulle part,
  // mais conservée en base pour un contrôle fiscal éventuel. Une ligne encore
  // PENDING peut en revanche être vraiment supprimée (voir services).
  deletedAt DateTime?

  // Rapprochement bancaire (une Dépense ↔ un débit du relevé importé).
  bankTransactionId String?          @unique
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  // Écriture générée automatiquement par un import Tesa+ (cotisations
  // salariales) ou "Cotisations non salarié" (voir SimpleImport.linkedEntryId)
  // — présent seulement dans ce cas.
  simpleImport      SimpleImport?

  @@index([tenantId, activity, status])
}

// ---------------------------------------------------------------------------
// Journal de caisse (vente directe) — Maraîchage et Fruits/Légumes uniquement
// ---------------------------------------------------------------------------

// Saisie journalière agrégée des ventes directes (une ligne par jour et par
// activité), DISTINCTE du livre des recettes : elle n'en est qu'une des
// sources. Pour Fruits/Légumes (100% vente directe), le livre des recettes ne
// contient que ces lignes. Pour Maraîchage, elles coexistent avec les lignes
// de facture (une ligne par facture ET une ligne par jour de vente directe),
// sans jamais être fusionnées même à date identique — voir docs/ARCHITECTURE.md.
//
// Comptes bancaires distincts : Fruits/Légumes n'encaisse qu'en espèces
// (checkAmount/cardAmount toujours à 0, justificatif = photo du bordereau de
// dépôt). Maraîchage agrège espèces/chèques/CB (justificatifs = bordereau +
// capture d'écran Up2Pay pour la part CB).
//
// La saisie agrégée journalière n'est légale que pour des ventes unitaires
// ≤ 76 € (BOI-BIC-DECLA-30-30, voir CASH_JOURNAL_DAILY_THRESHOLD dans
// lib/thresholds) : toute vente dépassant ce seuil doit être saisie à part
// dans exceptionalSales plutôt qu'agrégée dans cashAmount/checkAmount/cardAmount.
model CashJournalEntry {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  activity         Activity
  date             DateTime
  cashAmount       Decimal     @db.Decimal(12, 2) @default(0)
  checkAmount      Decimal     @db.Decimal(12, 2) @default(0) // Maraîchage uniquement
  cardAmount       Decimal     @db.Decimal(12, 2) @default(0) // Maraîchage uniquement
  // Photo prise CHAQUE jour de vente (comptage de caisse manuscrit ou ticket
  // Z) — PAS le bordereau de dépôt bancaire, qui est hebdomadaire et ne
  // permettrait pas de respecter l'obligation d'enregistrement jour par jour
  // (BOI-BIC-DECLA-30-10). Sert de justificatif ET de source pour la lecture
  // automatique du montant (voir extractCashJournalAmount) : l'exploitant
  // n'y note jamais le fond de caisse fixe (30 €), qui n'entre donc jamais
  // dans le montant lu.
  depositSlipUrl   String?
  cardStatementUrl String? // capture d'écran app bancaire Up2Pay (Maraîchage, part CB)
  // Ventes unitaires > 76 € saisies à part, jamais agrégées ci-dessus.
  // Tableau JSON de { amountTtc: number, paymentMethod: string, description?: string }.
  exceptionalSales Json?
  status           EntryStatus @default(PENDING)
  validatedById    String?
  validatedAt      DateTime?
  createdAt        DateTime    @default(now())

  // Suppression douce une fois validée (voir Entry.deletedAt).
  deletedAt DateTime?

  // Rapprochement bancaire (une ou plusieurs saisies de caisse ↔ un crédit du
  // relevé importé). PAS unique côté saisie de caisse, contrairement à
  // Entry/Invoice : un dépôt en banque est souvent hebdomadaire et regroupe
  // plusieurs jours de vente — plusieurs CashJournalEntry peuvent donc
  // pointer vers le même BankTransaction (voir suggestReconciliationMatch,
  // groupe de jours cumulés).
  bankTransactionId String?
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  @@unique([tenantId, activity, date])
  @@index([tenantId, activity, status])
  @@index([bankTransactionId])
}

// ---------------------------------------------------------------------------
// Facturation / devis (moteur unique, transverse aux 3 activités)
// ---------------------------------------------------------------------------

enum InvoiceType {
  DEVIS
  FACTURE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  activity       Activity
  type           InvoiceType
  number         String        @unique // numérotation automatique par activité
  clientName     String
  clientAddress  String?
  issueDate      DateTime
  dueDate        DateTime?
  status         InvoiceStatus @default(DRAFT)
  // Comptabilité de caisse : c'est la date d'ENCAISSEMENT effectif, pas
  // issueDate, qui détermine l'exercice fiscal (BOFiP BOI-BA-BASE-20-10 en
  // micro-BA, principe identique en micro-BIC). Une facture SENT sans
  // paidAt est une CRÉANCE en cours ("Facturée — créance en cours") : elle
  // n'entre dans aucun calcul de CA/seuil/TVA tant que paidAt est vide.
  // Renseignée manuellement, ou automatiquement au rapprochement bancaire
  // (voir reconcileBankTransaction) avec la date de l'opération pointée.
  paidAt         DateTime?
  vatApplicable  Boolean       @default(false) // false tant que franchise en base s'applique
  abLabelShown   Boolean       @default(false)
  totalHt        Decimal       @db.Decimal(12, 2)
  totalVat       Decimal       @db.Decimal(12, 2)
  totalTtc       Decimal       @db.Decimal(12, 2)
  pdfUrl         String?
  paExternalId   String? // référence côté PA (Abby) une fois transmise
  createdAt      DateTime      @default(now())

  // Rapprochement bancaire (une facture ↔ un crédit du relevé importé).
  bankTransactionId String?          @unique
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  lines InvoiceLine[]
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  vatRate     Decimal @db.Decimal(5, 2) @default(0)
  lineTotal   Decimal @db.Decimal(12, 2)
}

// Répertoire Clients : chaque client est enregistré une fois (mentions
// obligatoires de facturation), puis réutilisable par sélection sur les
// factures suivantes — jamais retapé. Alimenté automatiquement à la
// création d'une facture avec un nom inconnu (voir createInvoice), et
// modifiable à tout moment depuis l'onglet Facturation. Pas de FK depuis
// Invoice — clientName/clientAddress y restent de simples chaînes
// (traçabilité d'une facture indépendante d'une fiche client modifiable
// plus tard), le répertoire n'est qu'un pense-bête réutilisable.
model Client {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  activity  Activity // Maraîchage ou Kerbooth 360 (seules activités facturantes)
  name      String
  address   String?
  siret     String?
  vatNumber String? // TVA intracommunautaire, si applicable
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, activity, name])
}

// Catalogue Produits/Prestations : même principe que le Répertoire Clients,
// pour les lignes de facture (désignation, prix, taux de TVA) — jamais
// recréé, le taux de TVA jamais re-sélectionné à chaque facture.
model Product {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  activity         Activity
  label            String
  defaultUnitPrice Decimal  @db.Decimal(12, 2)
  vatRate          Decimal  @db.Decimal(5, 2) @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, activity, label])
}

// ---------------------------------------------------------------------------
// Paie (volet salarié, micro-BA)
// ---------------------------------------------------------------------------

model PayrollEmployee {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  firstName String
  lastName  String
  contractInfo Json? // type de contrat, temps de travail, taux horaire, etc.
  createdAt DateTime @default(now())

  payslips Payslip[]
}

model Payslip {
  id          String   @id @default(cuid())
  employeeId  String
  employee    PayrollEmployee @relation(fields: [employeeId], references: [id])
  period      String // ex. "2026-09"
  grossAmount Decimal  @db.Decimal(12, 2)
  netAmount   Decimal  @db.Decimal(12, 2)
  dsnStatus   String?  // statut de transmission DSN
  pdfUrl      String?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// TVA / déclarations
// ---------------------------------------------------------------------------

model TvaDeclaration {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  period    String // ex. "2026-T3" pour un acompte trimestriel RSA
  regime    String // "RSA" (régime simplifié agricole), "3517-AGR-SD" (Cerfa n°10968), etc.
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("A_PREPARER") // A_PREPARER / DEPOSEE / PAYEE
  dueDate   DateTime
  createdAt DateTime @default(now())
}

// Acompte TVA (Maraîchage, régime simplifié agricole) : simple import après
// paiement (justificatif), même cycle PENDING/VALIDATED que le reste des
// registres. Le Registre TVA (calcul automatique, voir lib/tva) confronte
// ces paiements enregistrés au montant réellement dû par trimestre.
model TvaInstallment {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  dueLabel        String // ex. "2026-T3", ou "Régularisation annuelle"
  amountPaid      Decimal     @db.Decimal(12, 2)
  paidAt          DateTime
  justificatifUrl String?
  fileHash        String? // détection de doublon — voir lib/dedup.ts
  status          EntryStatus @default(PENDING)
  validatedById   String?
  validatedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())

  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// Suivi des seuils (agent de suivi/alerte)
// ---------------------------------------------------------------------------

enum ThresholdScope {
  BIC_COMBINED // fruits/légumes + photobooth cumulés (même micro-entreprise)
  BA_MARAICHAGE
}

model ThresholdSnapshot {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  scope        ThresholdScope
  period       String // ex. "2026"
  caCumule     Decimal        @db.Decimal(12, 2)
  thresholdRef Decimal        @db.Decimal(12, 2) // ex. 37500 ou 85000
  alertLevel   String         @default("OK") // OK / VIGILANCE / DEPASSEMENT
  computedAt   DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Intégration PA (facturation électronique)
// ---------------------------------------------------------------------------

model PaConnection {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  provider       String   @default("ABBY")
  apiKeyEncrypted String
  status         String   @default("DISCONNECTED") // DISCONNECTED / CONNECTED / ERROR
  connectedAt    DateTime?
}

// Boîte mail de capture dédiée à une activité (une par activité, saisie et
// testée depuis Réglages — pas fixée en dur au déploiement). Le mot de passe
// IMAP est chiffré avant stockage (voir src/lib/crypto.ts).
model MailboxConnection {
  id                    String    @id @default(cuid())
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  activity              Activity
  imapHost              String?
  imapPort              Int       @default(993)
  imapUser              String?
  imapPasswordEncrypted String?
  status                String    @default("NOT_TESTED") // NOT_TESTED / CONNECTED / ERROR
  lastError             String?
  lastTestedAt          DateTime?
  updatedAt             DateTime  @updatedAt

  @@unique([tenantId, activity])
}

// ---------------------------------------------------------------------------
// Notifications (n8n / email)
// ---------------------------------------------------------------------------

model NotificationLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  channel   String // "EMAIL" / "N8N"
  type      String // ex. "ENTRY_PENDING_TOO_LONG", "THRESHOLD_ALERT", "DECLARATION_DUE"
  payload   Json?
  sentAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Imports simples (Tesa+, Cotisations non salarié) — upload + date, sans
// calculateur : tous les types de documents d'une même catégorie sont
// traités de façon identique. Voir docs/ARCHITECTURE.md.
// ---------------------------------------------------------------------------

enum SimpleImportCategory {
  TESA_CONTRAT
  TESA_BULLETIN_PAIE
  TESA_COTISATIONS_SALARIALES
  TESA_CERTIFICAT_TRAVAIL
  TESA_ATTESTATION_POLE_EMPLOI
  TESA_SOLDE_TOUT_COMPTE
  COTISATION_NON_SALARIE // appel de cotisation MSA de l'exploitant (Maraîchage)
}

model SimpleImport {
  id       String               @id @default(cuid())
  tenantId String
  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  activity Activity // BA_MARAICHAGE pour toutes les catégories actuelles (Tesa+ et cotisation non salarié)
  category SimpleImportCategory
  period   String? // ex. "2026-09" (période de contrat ou d'appel de cotisation)
  date     DateTime
  fileUrl  String
  fileHash String // détection de doublon — voir lib/dedup.ts

  // Montant optionnel (obligatoire en pratique pour COTISATION_NON_SALARIE et
  // TESA_COTISATIONS_SALARIALES, qui génèrent une ligne de Dépense à la
  // validation — voir linkedEntry).
  amountTtc Decimal? @db.Decimal(12, 2)

  // Même cycle PENDING/VALIDATED que le reste des registres. La Dépense
  // liée (linkedEntry) n'est créée qu'à la validation, pas à l'import — pour
  // ne jamais faire apparaître une dépense avant confirmation humaine.
  status        EntryStatus @default(PENDING)
  validatedById String?
  validatedAt   DateTime?
  deletedAt     DateTime? // suppression douce une fois validée

  linkedEntryId String? @unique
  linkedEntry   Entry?  @relation(fields: [linkedEntryId], references: [id])

  possibleDuplicateOfId String?
  possibleDuplicateOf   SimpleImport?  @relation("SimpleImportDuplicate", fields: [possibleDuplicateOfId], references: [id])
  duplicateCandidates   SimpleImport[] @relation("SimpleImportDuplicate")
  duplicateConfirmed    Boolean        @default(false) // saisie malgré l'alerte de doublon probable

  createdAt DateTime @default(now())

  @@index([tenantId, activity, category])
}

// ---------------------------------------------------------------------------
// Relevé bancaire et rapprochement — un compte réel par activité (Maraîchage,
// Fruits/Légumes, Kerbooth 360 : 3 comptes distincts). Import simple
// (PDF/CSV téléchargé depuis la banque en ligne), pas de connexion DSP2 en
// v1. Chaque ligne peut être rapprochée d'une Dépense (Entry), d'une facture
// ou d'une saisie de caisse — jamais les deux sens à la fois, un seul FK par
// cible, posé côté cible (voir Entry/Invoice/CashJournalEntry.bankTransactionId).
// ---------------------------------------------------------------------------

enum BankTransactionDirection {
  DEBIT
  CREDIT
}

model BankTransaction {
  id             String                   @id @default(cuid())
  tenantId       String
  tenant         Tenant                   @relation(fields: [tenantId], references: [id])
  activity       Activity
  date           DateTime
  label          String // libellé tel qu'il apparaît sur le relevé
  amount         Decimal                  @db.Decimal(12, 2) // toujours positif ; le sens est donné par `direction`
  direction      BankTransactionDirection
  sourceFileUrl  String? // relevé d'origine (CSV/PDF) dont la ligne est issue
  sourceFileHash String? // détection de doublon d'import (même relevé importé deux fois)

  possibleDuplicateOfId String?
  possibleDuplicateOf   BankTransaction?  @relation("BankTransactionDuplicate", fields: [possibleDuplicateOfId], references: [id])
  duplicateCandidates   BankTransaction[] @relation("BankTransactionDuplicate")
  duplicateConfirmed    Boolean           @default(false)

  // Même cycle PENDING/VALIDATED que le reste des registres : une ligne
  // importée reste "en attente" tant qu'elle n'a pas été relue, "Valider"
  // la confirme en un clic.
  status        EntryStatus @default(PENDING)
  validatedById String?
  validatedAt   DateTime?

  deletedAt DateTime? // suppression douce (ligne déjà validée)
  createdAt DateTime  @default(now())

  entry             Entry?
  invoice           Invoice?
  // Plusieurs saisies de caisse (dépôt hebdomadaire regroupant plusieurs
  // jours de vente) peuvent pointer vers le même BankTransaction — voir
  // CashJournalEntry.bankTransactionId.
  cashJournalEntries CashJournalEntry[]

  @@index([tenantId, activity, direction, date])
}

// ---------------------------------------------------------------------------
// Clôture d'exercice — transversale aux 3 activités (un seul bouton "Clôturer
// l'exercice [année]"). Verrouille l'exercice en lecture seule une fois
// posée : voir server/services/fiscalYearClosure (assertYearNotClosed),
// appelé par les "Supprimer la ligne"/rapprochements des différents
// registres. Ne bloque JAMAIS sur les créances/dettes en cours : elles
// restent modifiables après clôture, et rejoignent l'année où leur paiement
// tombe réellement une fois réglées (voir Entry.paidAt / Invoice.paidAt).
// Clôture uniquement possible dans l'ordre chronologique (voir
// listPendingBlockers / assertChronologicalOrder).
// ---------------------------------------------------------------------------

model FiscalYearClosure {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  year       Int
  closedById String?
  // Dossier ZIP généré à la clôture (synthèses PDF par activité + récap
  // créances/dettes en cours + pièces sources organisées par activité/
  // sous-onglet) — conservé pour retéléchargement, jamais régénéré à la volée
  // pour un exercice déjà clos (les pièces qu'il contient sont figées).
  zipFileUrl String?
  createdAt  DateTime @default(now())

  @@unique([tenantId, year])
}

// ---------------------------------------------------------------------------
// Kerbooth 360° — location de photobooths (activité BIC_PHOTOBOOTH)
// Voir kerbooth360/architecture-decision.md : Phase 1 (Benoît seul, 2
// unités) construite ici directement dans la base compta, sans Supabase —
// migration vers un projet Supabase partagé prévue seulement en Phase 2,
// quand le partenaire rejoint avec ses propres unités.
// ---------------------------------------------------------------------------

// Une unité physique (photobooth + iPhone associé, sticker portant le même
// nom sur les deux — voir feuille de route). `ownerLabel` reste un simple
// texte libre non contraint : en Phase 1 il n'y a qu'un seul propriétaire,
// aucune logique de répartition à modéliser tant que la Phase 2 n'existe pas.
model KerboothUnit {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  label        String // nom de fleur, ex. "Camélia"
  baseLocation String // "Tourc'h"
  ownerLabel   String   @default("Benoît")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  bookings KerboothBooking[]

  @@unique([tenantId, label])
}

enum KerboothFormula {
  ESSENTIEL
  POPULAIRE
  ENTREPRISE
}

// Le contrat doit être signé AVANT le paiement (revu le 20/09/2026 : la
// page de signature s'affiche avant la page de paiement, pas après).
// Paiement direct en une fois (revu le 20/09/2026 à la demande de Benoît :
// plus d'acompte/solde séparés — évite la conservation de carte pour un
// débit différé et le risque d'échec de prélèvement du solde). Plus de
// statut COMPLETED distinct : CONFIRMED = payé intégralement, rien à
// suivre après (voir kerbooth360/architecture-decision.md).
enum KerboothBookingStatus {
  PENDING_SIGNATURE // créée, contrat pas encore signé
  PENDING_PAYMENT // contrat signé, paiement pas encore reçu
  CONFIRMED // payée intégralement, réservation ferme
  CANCELLED // annulée — jamais de remboursement automatique (voir CGV article 5)
}

// Une réservation cliente. `unitId` posé par le dispatch automatique (voir
// server/services/kerbooth/dispatch.ts) dès qu'une unité libre est trouvée —
// vide tant qu'aucune unité n'a encore été assignée (ne devrait durer qu'un
// instant, le dispatch tourne dans le même appel n8n que la création).
model KerboothBooking {
  id             String                @id @default(cuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  unitId         String?
  unit           KerboothUnit?         @relation(fields: [unitId], references: [id])
  clientName     String
  clientEmail    String?
  clientPhone    String?
  eventDateStart DateTime
  eventDateEnd   DateTime
  // Adresse de livraison/installation — obligatoire au contrat (article 1,
  // voir kerbooth360/documents/documents-types-kerbooth360.md §5).
  eventLocation  String  @default("")
  formula        KerboothFormula
  durationDays   Int
  status         KerboothBookingStatus @default(PENDING_SIGNATURE)
  totalAmount    Decimal               @db.Decimal(12, 2)

  // Références externes posées par les workflows n8n au fil du parcours —
  // simples chaînes, jamais de FK vers un système tiers (Stripe/Yousign).
  stripeCustomerId String?
  yousignRequestId String?
  // client_secret de la session Stripe Checkout embarquée (ui_mode:
  // "embedded") — lu par le site via l'endpoint de statut le temps que le
  // client reste sur la page après la signature (voir déclencheur 4bis,
  // parcours embarqué signature+paiement sur le site).
  stripeCheckoutClientSecret String?

  // Facture créée dans l'outil compta (voir server/services/invoices) —
  // référence souple, pas de relation Prisma formelle : une facture reste
  // indépendante d'une réservation modifiée plus tard, même principe déjà
  // retenu pour Client/Product (voir docs/ARCHITECTURE.md §14).
  invoiceId String?

  contractSignedAt DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, eventDateStart, eventDateEnd])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // ex. "ENTRY_VALIDATED", "INVOICE_CREATED", "SETTINGS_UPDATED"
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
}
